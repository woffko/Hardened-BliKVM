[Unit]
Description=Hardened BliKVM PicoClaw configuration helper for the web server
Documentation=https://github.com/woffko/Hardened-BliKVM

[Socket]
# Only the web server may connect; the helper also authenticates the peer UID
# with SO_PEERCRED.
ListenStream=/run/hardened-blikvm-picoclaw-api/picoclaw.sock
Accept=yes
SocketUser=hardened-blikvm-server
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
Backlog=4
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
