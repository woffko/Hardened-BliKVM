[Unit]
Description=Hardened BliKVM board profile server (KVMD-free)
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=hardened-blikvm-board-owner.service
After=hardened-blikvm-board-owner.service
Conflicts=hardened-blikvm-server.service hardened-blikvm-server-current.service hardened-blikvm-server-candidate.service
ConditionPathExists=/usr/share/hardened-blikvm/web/index.html

[Service]
Type=simple
User=hardened-blikvm-server
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm
StateDirectoryMode=0700
Environment=BLI_KVM_BIND=127.0.0.1:18080
Environment=BLI_KVM_WEB_ROOT=/usr/share/hardened-blikvm/web
Environment=BLI_KVM_STATE_DIR=/var/lib/hardened-blikvm
Environment=BLI_KVM_CONTROL_SOCKET=/run/hardened-blikvm-gadget/control.sock
Environment=BLI_KVM_BROKER_SOCKET=/run/hardened-blikvm/platform-broker.sock
Environment=BLI_KVM_VIDEO_SOCKET=/run/hardened-blikvm-video/mjpeg.sock
Environment=BLI_KVM_RESTRICTED_CONTROLS=1
Environment=BLI_KVM_MEDIA_CONTROLS=1
Environment=BLI_KVM_MEDIA_CATALOG=/etc/hardened-blikvm-gadget/catalog.json
Environment=BLI_KVM_MEDIA_DIRECTORY=/var/lib/hardened-blikvm-gadget/images
Environment=BLI_KVM_SECURE_COOKIES=1
Environment=BLI_KVM_ALLOW_MISSING_ORIGIN=0
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-server
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
# The server owns the media write path: uploaded images land in the images
# directory and the catalog is rewritten in place.
ReadWritePaths=/var/lib/hardened-blikvm-gadget/images /etc/hardened-blikvm-gadget
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:18080
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
