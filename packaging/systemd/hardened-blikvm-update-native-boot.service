[Unit]
Description=Start or recover the native Hardened BliKVM application composition
Documentation=https://github.com/woffko/Hardened-BliKVM
# Native profile only. The managed units have no [Install] section there and
# are started by the root helper on this coordinator's request, so this unit
# is not ordered before them and no recover/server cycle exists.
Requires=hardened-blikvm-update-exec.socket
After=local-fs.target systemd-tmpfiles-setup.service hardened-blikvm-update-exec.socket
Conflicts=hardened-blikvm-update-recover.service
# A failed attempt is tried again (see Restart= below); four attempts of at
# most 75 s each fit in this window, so the limit ends a cause that stays.
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=oneshot
RemainAfterExit=yes
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm-update
StateDirectoryMode=0700
RuntimeDirectory=hardened-blikvm-update
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=update-supervisor-config:/etc/hardened-blikvm/update-supervisor.json
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /run/credentials/%n/update-supervisor-config boot-native
# The composition attempt is bounded to 45 seconds by the coordinator.
TimeoutStartSec=60s
# Early in a boot an attempt can fail on a passing cause: at gate Y of the
# code audit of 2026-10-20 the first attempt failed while the board was busy
# starting, and the same attempt succeeded later. The coordinator reconciles
# what an attempt left, so a later one starts from a known state.
Restart=on-failure
RestartSec=15s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-slots -/var/lib/hardened-blikvm-slots-v2 /var/lib/hardened-blikvm-update -/var/lib/hardened-blikvm-update-v2 /run/hardened-blikvm-update
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
