[Unit]
Description=Hardened BliKVM native execution helper session
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target

[Service]
Type=oneshot
# Root is required for systemd unit control, protected execution copies and
# identity observation of other users' processes. The helper never opens the
# update journal; it serves one bounded session per connection.
User=root
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-exec-helper --config /etc/hardened-blikvm/exec-helper.json serve-stdin
# One session is bounded to 90 seconds by the helper itself.
TimeoutStartSec=100s
MemoryMax=256M
TasksMax=32
LimitNOFILE=256
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# Only /proc/<pid> entries are needed; other processes must stay visible.
ProcSubset=pid
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-exec /var/lib/hardened-blikvm-exec-ledger
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# DAC capabilities read update-owned slots and reach component sockets;
# SYS_PTRACE reads /proc/<pid>/exe of services running as other users.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
