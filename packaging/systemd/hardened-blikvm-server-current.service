[Unit]
Description=Hardened BliKVM confirmed application server
Documentation=https://github.com/woffko/Hardened-BliKVM
# The confirmed slot is served by our board arrangement: the board owner owns
# the gadget, ATX, HID and media control socket, and the board video proxy owns
# the MJPEG socket. The signed payload itself is still executed from the slot.
Requires=hardened-blikvm-board-owner.service hardened-blikvm-update-recover.service
Wants=hardened-blikvm-board-video-proxy.service
After=hardened-blikvm-board-owner.service hardened-blikvm-board-video-proxy.service hardened-blikvm-update-recover.service
Conflicts=hardened-blikvm-server.service hardened-blikvm-server-candidate.service
ConditionPathExists=/var/lib/hardened-blikvm-slots/current/bin/bli-kvm-server
ConditionPathExists=/var/lib/hardened-blikvm-slots/current/share/web/index.html

[Service]
Type=simple
User=hardened-blikvm-server
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm
StateDirectoryMode=0700
# The firewall mode surface (BLI_KVM_FIREWALL_MODES=1) follows the owner's
# reviewed configuration in the same operator-supplied file.
EnvironmentFile=-/etc/hardened-blikvm/firewall.env
Environment=BLI_KVM_BIND=127.0.0.1:18080
Environment=BLI_KVM_ADMIN_SOCKET=/run/hardened-blikvm-admin/admin.sock
Environment=BLI_KVM_DOWNLOAD_SOCKET=/run/hardened-blikvm-download-api/download.sock
Environment=BLI_KVM_PICOCLAW_SOCKET=/run/hardened-blikvm-picoclaw-api/picoclaw.sock
Environment=BLI_KVM_WEB_ROOT=/var/lib/hardened-blikvm-slots/current/share/web
Environment=BLI_KVM_STATE_DIR=/var/lib/hardened-blikvm
Environment=BLI_KVM_BROKER_SOCKET=/run/hardened-blikvm/platform-broker.sock
Environment=BLI_KVM_CONTROL_SOCKET=/run/hardened-blikvm-gadget/control.sock
Environment=BLI_KVM_RESTRICTED_CONTROLS=1
Environment=BLI_KVM_MEDIA_CONTROLS=1
Environment=BLI_KVM_MEDIA_CATALOG=/etc/hardened-blikvm-gadget/catalog.json
Environment=BLI_KVM_MEDIA_DIRECTORY=/var/lib/hardened-blikvm-gadget/images
Environment=BLI_KVM_VIDEO_SOCKET=/run/hardened-blikvm-video/mjpeg.sock
# nginx takes the MJPEG stream from this socket: its buffer stays small,
# while nginx's loopback TCP receive buffer grew to megabytes of old frames.
Environment=BLI_KVM_STREAM_SOCKET=/run/hardened-blikvm-stream/mjpeg.sock
RuntimeDirectory=hardened-blikvm-stream
RuntimeDirectoryMode=0755
Environment=BLI_KVM_SECURE_COOKIES=1
Environment=BLI_KVM_ALLOW_MISSING_ORIGIN=0
ExecStart=/var/lib/hardened-blikvm-slots/current/bin/bli-kvm-server
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
# Allow the server's 20-second HTTP/WebSocket drain to report its result.
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-gadget/images /etc/hardened-blikvm-gadget
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:18080
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
