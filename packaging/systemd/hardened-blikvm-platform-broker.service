[Unit]
Description=Hardened BliKVM read-only platform broker
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=kvmd.service
After=kvmd.service
Before=hardened-blikvm-server.service
ConditionPathExists=/run/kvmd/kvmd.sock

[Service]
Type=simple
User=hardened-blikvm-broker
Group=hardened-blikvm
SupplementaryGroups=kvmd
UMask=0007
RuntimeDirectory=hardened-blikvm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
LoadCredential=kvmd-user:/etc/hardened-blikvm/kvmd-user
LoadCredential=kvmd-password:/etc/hardened-blikvm/kvmd-password
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-platform-broker
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
ReadWritePaths=/run/hardened-blikvm
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
