[Unit]
Description=Apply Hardened BliKVM confirmed application service
Documentation=https://github.com/woffko/Hardened-BliKVM
ConditionPathExists=!/run/hardened-blikvm-update/health-token
ConditionPathExists=/run/hardened-blikvm-update/confirmed-apply-request.json

[Service]
Type=oneshot
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
LoadCredential=update-supervisor-config:/etc/hardened-blikvm/update-supervisor.json
LoadCredential=confirmed-apply-request:/run/hardened-blikvm-update/confirmed-apply-request.json
StandardInput=null
ExecStart=+/usr/bin/systemctl --no-ask-password restart hardened-blikvm-server-current.service
ExecStartPost=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /run/credentials/%n/update-supervisor-config ack-confirmed-apply-credential
TimeoutStartSec=20s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/hardened-blikvm-update
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
