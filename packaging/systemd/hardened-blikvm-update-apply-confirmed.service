[Unit]
Description=Apply Hardened BliKVM confirmed application service
Documentation=https://github.com/woffko/Hardened-BliKVM
ConditionPathExists=!/run/hardened-blikvm-update/health-token

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart hardened-blikvm-server-current.service
TimeoutStartSec=20s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
