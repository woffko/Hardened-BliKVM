[Unit]
Description=Hardened BliKVM application update watchdog
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target
OnSuccess=hardened-blikvm-update-apply-confirmed.service
ConditionPathExists=/etc/hardened-blikvm/update-supervisor.json
ConditionPathExists=/var/lib/hardened-blikvm-update/application-state.json
ConditionPathIsDirectory=/var/lib/hardened-blikvm-slots

[Service]
Type=oneshot
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm-update
StateDirectoryMode=0700
RuntimeDirectory=hardened-blikvm-update
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=update-supervisor-config:/etc/hardened-blikvm/update-supervisor.json
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /run/credentials/%n/update-supervisor-config watchdog-once
TimeoutStartSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-slots /var/lib/hardened-blikvm-update /run/hardened-blikvm-update
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
