[Unit]
Description=Hardened BliKVM MJPEG streamer (vendor ustreamer, KVMD-free)
Documentation=https://github.com/woffko/Hardened-BliKVM
Conflicts=kvmd.service
After=local-fs.target
ConditionPathExists=/dev/kvmd-video

[Service]
Type=simple
User=hardened-blikvm-video
Group=hardened-blikvm
SupplementaryGroups=video
UMask=0007
RuntimeDirectory=hardened-blikvm-ustreamer
RuntimeDirectoryMode=0750
Environment=BLI_KVM_USTREAMER_SOCKET=/run/hardened-blikvm-ustreamer/ustreamer.sock
# Reviewed defaults; the privileged owner rewrites the file below from the
# accepted video-settings request and restarts this unit.
Environment=BLI_KVM_USTREAMER_FPS=30
# Frame detect (the reference's MJPEG setting); the owner may override it.
Environment=BLI_KVM_USTREAMER_DROP_SAME_FRAMES=30
Environment=BLI_KVM_USTREAMER_QUALITY=80
Environment=BLI_KVM_USTREAMER_RESOLUTION=1280x720
# Processed after the defaults on purpose: the accepted request wins.
EnvironmentFile=-/var/lib/hardened-blikvm-video/ustreamer.env
ExecStart=/usr/bin/ustreamer \
  --device=/dev/kvmd-video \
  --persistent \
  --format=mjpeg \
  --resolution=${BLI_KVM_USTREAMER_RESOLUTION} \
  --desired-fps=${BLI_KVM_USTREAMER_FPS} \
  --quality=${BLI_KVM_USTREAMER_QUALITY} \
  --drop-same-frames=${BLI_KVM_USTREAMER_DROP_SAME_FRAMES} \
  --unix=/run/hardened-blikvm-ustreamer/ustreamer.sock \
  --unix-rm \
  --unix-mode=0660 \
  --slowdown
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
# The capture device by the name the rule of this project gives it
# (packaging/udev/99-hardened-blikvm-video.rules), resolved when the unit
# starts: its number depends on which other video drivers were loaded
# before it.
DeviceAllow=/dev/kvmd-video rw
IPAddressDeny=any
ReadWritePaths=/run/hardened-blikvm-ustreamer
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
