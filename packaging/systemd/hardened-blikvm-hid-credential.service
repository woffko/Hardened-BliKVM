[Unit]
Description=Hardened BliKVM HID credential delivery gate
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=kvmd.service
After=kvmd.service

[Service]
Type=oneshot
User=hardened-blikvm-hid
Group=hardened-blikvm
UMask=0077
LoadCredential=kvmd-user:/etc/hardened-blikvm/hid/kvmd-user
LoadCredential=kvmd-password:/etc/hardened-blikvm/hid/kvmd-password
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-hid-credential-gate
TimeoutStartSec=15s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
