[Unit]
Description=Hardened BliKVM synthetic diagnostic persistence gate
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target

[Service]
Type=oneshot
User=hardened-blikvm-broker
Group=hardened-blikvm
UMask=0077
RuntimeDirectory=hardened-blikvm-diagnostics
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=diagnostic-journal-keyring:/etc/hardened-blikvm/diagnostic-journal-keyring
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-diagnostic-persistence-gate
TimeoutStartSec=30s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-diagnostics /run/hardened-blikvm-diagnostics
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
