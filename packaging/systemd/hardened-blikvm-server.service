[Unit]
Description=Hardened BliKVM authenticated loopback server
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=hardened-blikvm-platform-broker.service
After=hardened-blikvm-platform-broker.service
ConditionPathExists=/usr/share/hardened-blikvm/web/index.html

[Service]
Type=simple
User=hardened-blikvm-server
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm
StateDirectoryMode=0700
Environment=BLI_KVM_BIND=127.0.0.1:18080
Environment=BLI_KVM_WEB_ROOT=/usr/share/hardened-blikvm/web
Environment=BLI_KVM_STATE_DIR=/var/lib/hardened-blikvm
Environment=BLI_KVM_BROKER_SOCKET=/run/hardened-blikvm/platform-broker.sock
Environment=BLI_KVM_SECURE_COOKIES=1
Environment=BLI_KVM_ALLOW_MISSING_ORIGIN=0
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-server
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:18080
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
