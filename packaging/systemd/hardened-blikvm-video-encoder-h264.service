[Unit]
Description=Hardened BliKVM H.264 encoder for the WebRTC and QUIC video paths
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=hardened-blikvm-ustreamer.service
After=hardened-blikvm-ustreamer.service hardened-blikvm-janus.service hardened-blikvm-ve.service
Wants=hardened-blikvm-janus.service

[Service]
Type=simple
DynamicUser=yes
# Read access to the uStreamer socket, which is group hardened-blikvm; as the
# primary group it also owns the demand socket below (chown is filtered).
Group=hardened-blikvm
SupplementaryGroups=hardened-blikvm hardened-blikvm-ve
UMask=0077
# The web server holds this socket open while a WebRTC viewer is connected;
# without one the encoder leaves the capture stream and takes no CPU. The
# socket is group hardened-blikvm, mode 0660.
RuntimeDirectory=hardened-blikvm-h264
RuntimeDirectoryMode=0755
Environment=BLI_KVM_VP8_DEMAND_SOCKET=/run/hardened-blikvm-h264/demand.sock
# The QUIC gateway reads the encoded frames from this socket, and only its
# user is served (docs/design/quic-transport-v1.md). On a board without that
# user the socket stays closed and nothing else changes.
Environment=BLI_KVM_ENCODER_FRAME_SOCKET=/run/hardened-blikvm-h264/frames.sock
Environment=BLI_KVM_ENCODER_FRAME_USER=hardened-blikvm-quic
Environment=BLI_KVM_ENCODER_CODEC=h264-ultrafast
# The board's video engine encodes H.264 where its driver is loaded
# (docs/design/h616-ve-encoder-driver-v1.md): the encoder opens this device,
# tries it with one picture, and uses x264 when it is not there or fails,
# with a line in the journal, or when the board's choice is x264 (the web
# server sends it on the demand socket). Which of the two encodes is one
# word in the status file, which the web server reads for the interface.
# The report says that, the choice, and whether the engine can be had
# (docs/design/h264-engine-choice-and-quality-monitor-v1.md).
Environment=BLI_KVM_ENCODER_HARDWARE=/dev/hardened-blikvm-ve-enc
Environment=BLI_KVM_ENCODER_STATUS=/run/hardened-blikvm-h264/encoder
Environment=BLI_KVM_ENCODER_REPORT=/run/hardened-blikvm-h264/report.json
# The engine encodes a frame in 7 ms and takes no processor: decoding the
# capture's JPEG frames is what bounds the frame rate then, and gets a
# third thread.
Environment=BLI_KVM_ENCODER_CONVERTERS=3
Environment=BLI_KVM_ENCODER_RTP_PORT=5006
Environment=BLI_KVM_USTREAMER_SOCKET=/run/hardened-blikvm-ustreamer/ustreamer.sock
Environment=BLI_KVM_VP8_MAX_FPS=30
Environment=BLI_KVM_VP8_KBPS=2500
Environment=BLI_KVM_VP8_THREADS=3
EnvironmentFile=-/etc/hardened-blikvm/video-encoder.env
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-video-encoder
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
# Keep one core for HID, the owner and the MJPEG path under full motion.
CPUQuota=250%
MemoryMax=160M
# Six threads of its own, six of x264, one for every viewer's demand (two
# WebRTC viewers, eight QUIC sessions) and two for every client of the frame
# socket (four): 30.
TasksMax=40
NoNewPrivileges=yes
# The video engine's encoder device and no other: the device policy below
# is closed, and the node belongs to this group alone
# (packaging/udev/99-hardened-blikvm-ve.rules).
PrivateDevices=no
DeviceAllow=/dev/hardened-blikvm-ve-enc rw
PrivateNetwork=no
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
