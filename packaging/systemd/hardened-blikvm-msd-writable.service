[Unit]
Description=Hardened BliKVM MSD remount writable
Documentation=https://github.com/woffko/Hardened-BliKVM
# The reviewed MSD partition can come up read-only when the initramfs or the
# boot-time fsck holds it first; the images directory must be writable for
# uploads and writable media, so this unit remounts it once the mount exists.
RequiresMountsFor=/var/lib/hardened-blikvm-gadget/images
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount -o remount,rw /var/lib/hardened-blikvm-gadget/images
# One remount, which must happen in the host's mount namespace: no option
# here makes one of its own (ProtectSystem= and the like would). The rest of
# the sandbox: CAP_SYS_ADMIN alone, no network, a system-call filter
# (security review of 2026-10-18, LOW-07).
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
