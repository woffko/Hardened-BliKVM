[Unit]
Description=Hardened BliKVM HID+ATX restricted control transition (test build only)
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=kvmd.service
After=kvmd.service
Before=hardened-blikvm-server.service hardened-blikvm-server-current.service

[Service]
Type=simple
User=hardened-blikvm-hid
Group=hardened-blikvm
SupplementaryGroups=kvmd
UMask=0077
RuntimeDirectory=hardened-blikvm-control-transition
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
Environment=BLI_KVM_CONTROL_SOCKET=/run/hardened-blikvm-control-transition/control.sock
Environment=BLI_KVM_HID_PROFILE=1
Environment=BLI_KVM_HID_LEDGER=/var/lib/hardened-blikvm-control-transition/hid-ledger.json
Environment=BLI_KVM_HID_KVMD_SOCKET=/run/kvmd/kvmd.sock
Environment=BLI_KVM_ATX_PROFILE=1
Environment=BLI_KVM_ATX_JOURNAL=/var/lib/hardened-blikvm-control-transition/atx-journal.json
Environment=BLI_KVM_ATX_KVMD_SOCKET=/run/kvmd/kvmd.sock
LoadCredential=kvmd-user:/etc/hardened-blikvm/kvmd-user
LoadCredential=kvmd-password:/etc/hardened-blikvm/kvmd-password
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-control-broker
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
ReadWritePaths=/run/hardened-blikvm-control-transition /var/lib/hardened-blikvm-control-transition
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
