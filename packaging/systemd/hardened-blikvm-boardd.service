[Unit]
Description=Hardened BliKVM board daemon: fan and board peripherals (KVMD-free)
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target
Conflicts=kvmd-main.service
ConditionPathExists=/dev/gpiochip0
ConditionPathExists=/etc/hardened-blikvm-gadget/boardd.json

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=hardened-blikvm-boardd
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-boardd --config /etc/hardened-blikvm-gadget/boardd.json
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
# The status panel reads uptime, load, memory and the interface table from
# /proc; the process view stays hidden through ProtectProc=invisible.
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/spidev1.0 rw
IPAddressDeny=any
ReadWritePaths=/run/hardened-blikvm-boardd
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
