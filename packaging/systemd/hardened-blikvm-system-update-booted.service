[Unit]
Description=Hardened BliKVM RAW system update boot report
Documentation=https://github.com/woffko/Hardened-BliKVM
# Only after a RAW system update wrote a new root: marks it booted once the
# web stack answers, so the next boot keeps it instead of counting a failed
# attempt (docs/design/system-raw-update-v1.md).
ConditionPathExists=/mnt/.hardened-system-update/apply.json
RequiresMountsFor=/mnt
After=hardened-blikvm-nginx.service

[Service]
Type=simple
User=root
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-system-update booted
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/mnt/.hardened-system-update
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
# It asks the board's own web stack (https://127.0.0.1/api/health) and
# nothing else; not "localhost", which would admit Janus's loopback address
# (security review of 2026-10-18, LOW-07, MED-03).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1 ::1
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
