[Unit]
Description=Hardened BliKVM authenticated local update status response
Documentation=https://github.com/woffko/Hardened-BliKVM

[Service]
Type=oneshot
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
LoadCredential=update-supervisor-config:/etc/hardened-blikvm/update-supervisor.json
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /run/credentials/%n/update-supervisor-config status-socket --peer-user hardened-blikvm-server
TimeoutStartSec=5s
MemoryMax=64M
TasksMax=16
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
