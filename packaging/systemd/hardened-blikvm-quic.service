[Unit]
Description=Hardened BliKVM QUIC gateway
Documentation=https://github.com/woffko/Hardened-BliKVM
# The QUIC and TLS front of the QUIC transport
# (docs/design/quic-transport-v1.md). It is the board's switch: installed
# disabled, enabled and started, or stopped and disabled, by the board owner.
# It holds no authority and finds the web server's link by itself; without
# the server it serves nobody.
After=network.target

[Service]
Type=simple
User=hardened-blikvm-quic
Group=hardened-blikvm-quic
UMask=0077
Environment=BLI_KVM_QUIC_BIND=[::]:443
Environment=BLI_KVM_QUIC_LINK_SOCKET=/run/hardened-blikvm-quic-link/link.sock
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-quic-gateway
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

# Measured at 8 Mbit/s: 2.4 MiB. The limit bounds what a flood of packets or
# a fault in the QUIC stack can take from the board.
MemoryMax=64M
TasksMax=16
# UDP 443 and nothing else: the page's own origin, so its policy lets it
# connect. No other capability, and no other port can be bound.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SocketBindDeny=any
SocketBindAllow=udp:443
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed
# The owner's, the broker's and the other helpers' sockets are not its
# business; the server's link is the only one it uses.
InaccessiblePaths=-/run/hardened-blikvm-gadget -/run/hardened-blikvm -/run/hardened-blikvm-admin -/run/hardened-blikvm-update-api -/run/hardened-blikvm-exec-api
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
