[Unit]
Description=Hardened BliKVM local application update status
Documentation=https://github.com/woffko/Hardened-BliKVM

[Socket]
ListenStream=/run/hardened-blikvm-update-api/status.sock
Accept=yes
SocketUser=hardened-blikvm-update
SocketGroup=hardened-blikvm
SocketMode=0620
DirectoryMode=0755
Backlog=4
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
