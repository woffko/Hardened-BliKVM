[Unit]
Description=Hardened BliKVM board owner: USB gadget and ATX lines (test build only)
Documentation=https://github.com/woffko/Hardened-BliKVM
Before=hardened-blikvm-server.service hardened-blikvm-server-current.service

[Service]
Type=simple
User=root
# The service group comes from the reviewed drop-in that keeps the control
# socket reachable; the store instead sets the ownership of its journal copies
# explicitly, which is why CAP_CHOWN is kept.
UMask=0077
RuntimeDirectory=hardened-blikvm-gadget
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
# Reviewed ATX pulse timings and optional reconciliation path are supplied by
# the operator; the unit itself contains no hardware timing facts.
EnvironmentFile=-/etc/hardened-blikvm-gadget/atx.env
# Reviewed system-action commands and arming, supplied by the operator
# (BLI_KVM_SYSTEM_ACTION_PROFILE, BLI_KVM_SYSTEM_ACTION_ARMED,
# BLI_KVM_SYSTEM_ACTION_REBOOT_COMMAND, BLI_KVM_SYSTEM_ACTION_SHUTDOWN_COMMAND).
# Nothing is executed while the file is absent.
EnvironmentFile=-/etc/hardened-blikvm-gadget/system-action.env
Environment=BLI_KVM_CONTROL_SOCKET=/run/hardened-blikvm-gadget/control.sock
Environment=BLI_KVM_BOARD_PROFILE=1
Environment=BLI_KVM_GADGET_MEDIA_JOURNAL=/var/lib/hardened-blikvm-gadget/journal.json
Environment=BLI_KVM_GADGET_MEDIA_CATALOG=/etc/hardened-blikvm-gadget/catalog.json
Environment=BLI_KVM_GADGET_CONFIGFS=/sys/kernel/config/usb_gadget
Environment=BLI_KVM_GADGET_IMAGES=/var/lib/hardened-blikvm-gadget/images
Environment=BLI_KVM_GADGET_UDC=musb-hdrc.2.auto
Environment=BLI_KVM_GADGET_SERIAL_FILE=/etc/hardened-blikvm-gadget/serial
Environment=BLI_KVM_GADGET_HID_LEDGER=/var/lib/hardened-blikvm-gadget/hid-ledger.json
Environment=BLI_KVM_GADGET_HIDG_DIR=/dev
# The board profile serves the ATX pulses itself through the reviewed GPIO
# character-device executor; the line timings come from atx.env.
Environment=BLI_KVM_GPIO_ATX_PROFILE=1
Environment=BLI_KVM_ATX_JOURNAL=/var/lib/hardened-blikvm-gadget/atx-journal.json
Environment=BLI_KVM_ATX_CHIP=/dev/gpiochip0
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-control-broker
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=no
ProtectProc=invisible
ProtectSystem=strict
# The armed system-action profile reads the kernel boot identity from
# /proc/sys/kernel/random/boot_id, which ProcSubset=pid would hide.
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# The reviewed network writes need the per-interface disable_ipv6 sysctl and
# the resolver file is writable through ReadWritePaths. CAP_CHOWN lets the
# owner set the root ownership the system-action store requires on the journal
# copies it creates, which its service group cannot produce by itself.
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/hidg0 rw
DeviceAllow=/dev/hidg1 rw
DeviceAllow=/dev/hidg2 rw
IPAddressDeny=any
# The owner holds the privileged system-action journal, and the armed profile
# must persist a record before the reboot it triggers, so the store
# directory is writable together with the gadget and network surfaces.
ReadWritePaths=/sys/kernel/config/usb_gadget /run/hardened-blikvm-gadget /var/lib/hardened-blikvm-gadget /var/lib/hardened-blikvm-system-actions /var/lib/hardened-blikvm-video /etc/resolv.conf /etc/systemd/resolved.conf /etc/NetworkManager/system-connections
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
