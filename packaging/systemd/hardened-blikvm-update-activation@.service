[Unit]
Description=Hardened BliKVM guarded application activation request
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target
# The worker exits zero ONLY for a new AwaitingHealth transition, even if
# receipt delivery fails. Rejections/no-ops exit nonzero and do not dispatch.
OnSuccess=hardened-blikvm-update-apply-candidate.service hardened-blikvm-update-apply-confirmed.service

[Service]
Type=oneshot
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
StateDirectory=hardened-blikvm-update
StateDirectoryMode=0700
RuntimeDirectory=hardened-blikvm-update
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=update-supervisor-config:/etc/hardened-blikvm/update-supervisor.json
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /run/credentials/%n/update-supervisor-config activation-socket --peer-user hardened-blikvm-server
TimeoutStartSec=15s
MemoryMax=256M
TasksMax=16
LimitNOFILE=128
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/hardened-blikvm-slots -/var/lib/hardened-blikvm-slots-v2 /var/lib/hardened-blikvm-update -/var/lib/hardened-blikvm-update-v2 /run/hardened-blikvm-update -/run/hardened-blikvm-update-v2
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
