[Unit]
Description=Hardened BliKVM denied-by-default control policy broker
Documentation=https://github.com/woffko/Hardened-BliKVM
Before=hardened-blikvm-server.service

[Service]
Type=simple
User=hardened-blikvm-control
Group=hardened-blikvm
UMask=0077
RuntimeDirectory=hardened-blikvm-control
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
Environment=BLI_KVM_CONTROL_SOCKET=/run/hardened-blikvm-control/control.sock
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-control-broker
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
ReadWritePaths=/run/hardened-blikvm-control
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
