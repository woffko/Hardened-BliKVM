[Unit]
Description=Hardened BliKVM board video proxy (KVMD-free MJPEG)
Documentation=https://github.com/woffko/Hardened-BliKVM
Requires=hardened-blikvm-ustreamer.service
After=hardened-blikvm-ustreamer.service
Conflicts=hardened-blikvm-video-proxy.service
ConditionPathExists=/dev/kvmd-video

[Service]
Type=simple
User=hardened-blikvm-video
Group=hardened-blikvm
UMask=0007
RuntimeDirectory=hardened-blikvm-video
RuntimeDirectoryMode=0750
Environment=BLI_KVM_VIDEO_PROXY_SOCKET=/run/hardened-blikvm-video/mjpeg.sock
Environment=BLI_KVM_USTREAMER_SOCKET=/run/hardened-blikvm-ustreamer/ustreamer.sock
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-video-proxy
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
ReadWritePaths=/run/hardened-blikvm-video
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
