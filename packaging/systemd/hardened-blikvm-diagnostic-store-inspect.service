[Unit]
Description=Hardened BliKVM diagnostic store empty-state inspection
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target
ConditionPathIsDirectory=/var/lib/hardened-blikvm-diagnostics
ConditionPathExists=/var/lib/hardened-blikvm-diagnostics/journal-a.bin
ConditionPathExists=/var/lib/hardened-blikvm-diagnostics/journal-b.bin

[Service]
Type=oneshot
User=hardened-blikvm-broker
Group=hardened-blikvm
UMask=0077
LoadCredential=diagnostic-journal-keyring:/etc/hardened-blikvm/diagnostic-journal-keyring
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-diagnostic-maintenance inspect-empty
TimeoutStartSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
