[Unit]
Description=Hardened BliKVM transient typed diagnostic collector
Documentation=https://github.com/woffko/Hardened-BliKVM
After=local-fs.target

[Service]
Type=simple
User=hardened-blikvm-diagnostics
Group=hardened-blikvm
DynamicUser=yes
UMask=0117
RuntimeDirectory=hardened-blikvm-diagnostics
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-diagnostic-collector
Restart=on-failure
RestartSec=2s
TimeoutStartSec=10s
TimeoutStopSec=10s
StandardOutput=null
StandardError=journal

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/run/hardened-blikvm-diagnostics
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
