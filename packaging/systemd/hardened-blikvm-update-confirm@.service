[Unit]
Description=Hardened BliKVM one-use update health confirmation
Documentation=https://github.com/woffko/Hardened-BliKVM
ConditionPathExists=/etc/hardened-blikvm/update-supervisor.json
ConditionPathExists=/var/lib/hardened-blikvm-update/application-state.json

[Service]
Type=oneshot
User=hardened-blikvm-update
Group=hardened-blikvm
UMask=0077
StateDirectory=hardened-blikvm-update hardened-blikvm-slots
StateDirectoryMode=0700
RuntimeDirectory=hardened-blikvm-update
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/usr/libexec/hardened-blikvm/bli-kvm-update-supervisor --config /etc/hardened-blikvm/update-supervisor.json confirm-stdin
TimeoutStartSec=10s

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
