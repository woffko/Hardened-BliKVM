# Hardened BliKVM Janus core: streaming plugin and loopback WebSocket only.
general: {
	configs_folder = "/etc/hardened-blikvm-janus"
	plugins_folder = "/usr/lib/aarch64-linux-gnu/janus/plugins"
	transports_folder = "/usr/lib/aarch64-linux-gnu/janus/transports"
	events_folder = "/usr/lib/aarch64-linux-gnu/janus/events"
	loggers_folder = "/usr/lib/aarch64-linux-gnu/janus/loggers"
	log_to_stdout = true
	debug_level = 4
	# Sessions without a keepalive are reclaimed.
	session_timeout = 60
	# No admin API; the server is the only Janus client.
	admin_secret = ""
	protected_folders = [ "/bin", "/boot", "/dev", "/etc", "/lib", "/opt", "/proc", "/root", "/run", "/sbin", "/sys", "/usr", "/var" ]
}

media: {
	ipv6 = false
	rtp_port_range = "20000-20099"
	dtls_mtu = 1200
}

nat: {
	# LAN deployment without STUN/TURN; host candidates only.
	nice_debug = false
	ignore_mdns = true
	ice_ignore_list = "docker,veth,lo"
}

plugins: {
	disable = "libjanus_audiobridge.so,libjanus_echotest.so,libjanus_nosip.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_textroom.so,libjanus_videocall.so,libjanus_videoroom.so,libjanus_voicemail.so,libjanus_duktape.so,libjanus_lua.so"
}

transports: {
	disable = "libjanus_http.so,libjanus_pfunix.so,libjanus_mqtt.so,libjanus_nanomsg.so,libjanus_rabbitmq.so"
}

events: {
	broadcast = false
}

loggers: {
	disable = "libjanus_jsonlog.so"
}
